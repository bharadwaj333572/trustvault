# Database configuration
# In production, use standard PostgreSQL connection string:
# DATABASE_URL=postgresql://trustvault:trustvault_secret@localhost:5432/trustvault
# If omitted or starts with "memory://" or empty, TrustVault falls back to embedded PGlite for self-contained zero-config execution.
DATABASE_URL=

# Local private file storage directory (never publicly accessible)
STORAGE_DIR=./storage

# Security and Sessions
SESSION_SECRET=c8f8b3d64c1e40a79a32c5101a052ff37c598e217036495dbb0f588a4e3fae88
COOKIE_SECURE=false

# Server Configuration
PORT=3000
NODE_ENV=development
